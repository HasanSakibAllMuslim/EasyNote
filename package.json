{
  "name": "easynote-desktop",
  "version": "1.0.0",
  "description": "EasyNote Windows desktop application",
  "author": "EasyNote",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:icon": "node scripts/prepare-icon.cjs",
    "pre-dist": "npm run prepare:icon",
    "pre-dist:dir": "npm run prepare:icon",
    "test:release": "node --test tests/release-preflight.test.cjs",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win nsis --dir"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.1",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.easynote.desktop",
    "productName": "EasyNote",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "libs/**/*",
      "electron/**/*",
      "package.json",
      "build/**/*",
      "scripts/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EasyNote-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EasyNote",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
